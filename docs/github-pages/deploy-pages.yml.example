# ─────────────────────────────────────────────────────────────
# GitHub Pages デプロイ用ワークフローの雛形（現在は無効）
#
# このファイルは .github/workflows/ の外に置いてあるため実行されません。
# 公開はユーザーの承認後にのみ行います。手順は docs/github-pages.md を参照。
# ─────────────────────────────────────────────────────────────
name: Deploy to GitHub Pages

on:
  workflow_dispatch: # 手動実行のみ（push での自動公開はしない）

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-node@v5
        with:
          node-version-file: .nvmrc
      - run: npm install --no-audit --no-fund
      - run: npm run typecheck
      - run: npm test
      - run: npm run build:pages
      - uses: actions/upload-pages-artifact@v3
        with:
          path: dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
